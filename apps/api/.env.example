# `development` or `test` let the API boot with the public development JWT
# secret. Any other value (or none, as in production) requires JWT_SECRET.
NODE_ENV=development

DATABASE_URL=postgres://ainative:ainative@localhost:5433/ainative
TEST_DATABASE_URL=postgres://ainative:ainative@localhost:5433/ainative_test

# Required outside development/test: at least 32 random characters, e.g.
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=
